PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_gateway
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
DB_LOGGING=false # Set to 'true' if you want Sequelize to log all raw SQL queries
WA_PROVIDER=mock # Options: 'mock' (safe testing without real phone) or 'baileys' (connect real WhatsApp)

# Google Gemini AI Configuration
GEMINI_API_KEY= # Get your free key at https://aistudio.google.com/
GEMINI_MODEL=gemini-1.5-flash

