{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm install && npm --prefix client install && npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:create": "sequelize-cli db:create --config src/config/sequelize-cli-config.cjs",
    "db:drop": "sequelize-cli db:drop --config src/config/sequelize-cli-config.cjs",
    "migrate": "sequelize-cli db:migrate --config src/config/sequelize-cli-config.cjs --migrations-path src/db/migrations",
    "migrate:undo": "sequelize-cli db:migrate:undo --config src/config/sequelize-cli-config.cjs --migrations-path src/db/migrations",
    "migrate:status": "sequelize-cli db:migrate:status --config src/config/sequelize-cli-config.cjs --migrations-path src/db/migrations",
    "seed": "sequelize-cli db:seed:all --config src/config/sequelize-cli-config.cjs --seeders-path src/db/seeders"
  },

  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@whiskeysockets/baileys": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.3.1",
    "google-tts-api": "^2.0.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.2.0",
    "qrcode": "^1.5.3",
    "sequelize": "^6.37.3",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  }
}
